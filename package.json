{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "tsc --noEmit",
        "test:e2e": "bunx bddgen && bunx playwright test",
        "test:e2e:headed": "bunx bddgen && bunx playwright test --headed",
        "test:e2e:ui": "bunx bddgen && bunx playwright test --ui"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@eslint/js": "^9.39.5",
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^22.20.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.9.6",
        "playwright-bdd": "^9.2.0",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "typescript-eslint": "^8.68.0"
    },
    "dependencies": {
        "@inertiajs/react": "^3.7.0",
        "@inertiajs/vite": "^3.7.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^5.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.2.4",
        "globals": "^15.15.0",
        "laravel-vite-plugin": "^3.2.0",
        "lucide-react": "^1.34.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hot-toast": "^2.6.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "^8.2.2"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
        "lightningcss-linux-x64-gnu": "^1.33.0"
    }
}
